{
  "lines": [
    {
      "left": ["piState", "autoTitle", "title"],
      "sepLeft": " ",
      "right": ["model", "thinking", "stier"],
      "sepRight": " "
    },
    {
      "left": ["cwd"],
      "sepLeft": " ",
      "right": ["branch"],
      "sepRight": " "
    },
    {
      "left": ["tokIn", "tokOut", "cacheR", "cacheW", "cacheHit", "cost"],
      "sepLeft": " ",
      "right": ["ctxBar", "ctxPct", "ctxNums"],
      "sepRight": " "
    },
    {
      "left": ["elapsed", "ttftAvg", "tpsAvg"],
      "sepLeft": " ",
      "right": ["todayTok", "todayCost"],
      "sepRight": " "
    }
  ],
  "modules": {
    "cwd": {
      "source": "session.cwd",
      "color": "fg",
      "truncate": "start",
      "priority": 100
    },
    "piState": {
      "source": "ext-status",
      "key": "pi-status",
      "valueMap": {
        "idle": " ",
        "gen": " ",
        "done": " "
      },
      "color": {
        "map": {
          "idle": "comment",
          "gen": "cyan",
          "done": "green"
        },
        "default": "fgDark"
      },
      "priority": 115
    },
    "autoTitle": {
      "source": "ext-status",
      "key": "pi-auto-title",
      "color": "yellow",
      "priority": 110
    },
    "title": {
      "source": "session.name",
      "color": "yellow",
      "truncate": "end",
      "priority": 30
    },
    "branch": {
      "source": "footer.branch",
      "glyph": "\ue725",
      "color": "green",
      "priority": 60
    },
    "model": {
      "source": "model.id",
      "color": "blue",
      "priority": 95
    },
    "thinking": {
      "source": "thinking",
      "color": "magenta",
      "priority": 40
    },
    "stier": {
      "source": "ext-status",
      "key": "service-tier",
      "glyph": "\uf0e7",
      "color": {
        "map": {
          "priority": "orange",
          "flex": "blue",
          "scale": "green",
          "off": "comment"
        },
        "default": "fgDark"
      },
      "priority": 35
    },
    "tokIn": {
      "source": "usage.input",
      "glyph": "\uf01b",
      "format": "tok",
      "color": "cyan",
      "priority": 100
    },
    "tokOut": {
      "source": "usage.output",
      "glyph": "\uf01a",
      "format": "tok",
      "color": "green1",
      "priority": 95
    },
    "cacheR": {
      "source": "usage.cacheRead",
      "glyph": "\udb84\ude5b",
      "format": "tok",
      "color": "blue5",
      "priority": 50
    },
    "cacheW": {
      "source": "usage.cacheWrite",
      "glyph": "\udb84\ude59",
      "format": "tok",
      "color": "purple",
      "priority": 40
    },
    "cacheHit": {
      "source": "usage.ch",
      "glyph": "\uf49b",
      "format": "pct",
      "nullText": "0%",
      "color": "yellow",
      "priority": 45
    },
    "cost": {
      "source": "usage.cost",
      "glyph": "\uef8d",
      "format": "dollars3",
      "color": "orange",
      "priority": 70
    },
    "elapsed": {
      "source": "task.elapsedTotal",
      "glyph": "\uf520",
      "format": "hms",
      "nullText": "0s",
      "color": "green1",
      "priority": 95
    },
    "ctxLabel": {
      "source": "literal",
      "text": "ctx",
      "color": "comment",
      "priority": 100
    },
    "ctxBar": {
      "source": "ctx.bar",
      "cells": 8,
      "color": {
        "thresholds": [
          { "op": "gte", "n": 80, "color": "red" },
          { "op": "gte", "n": 50, "color": "yellow" }
        ],
        "default": "green"
      },
      "priority": 60
    },
    "ctxPct": {
      "source": "ctx.percent",
      "format": "pct",
      "nullText": "?",
      "color": {
        "thresholds": [
          { "op": "gte", "n": 80, "color": "red" },
          { "op": "gte", "n": 50, "color": "yellow" }
        ],
        "default": "green"
      },
      "priority": 95
    },
    "ctxNums": {
      "source": "ctx.nums",
      "color": "fgDark",
      "priority": 40
    },
    "ttft": {
      "source": "ttft",
      "format": "sec1",
      "nullText": "0.0s",
      "prefix": "ttft ",
      "color": {
        "thresholds": [
          { "op": "gte", "n": 3000, "color": "red" },
          { "op": "gte", "n": 1000, "color": "yellow" }
        ],
        "default": "green"
      },
      "priority": 100
    },
    "ttftAvg": {
      "source": "ttft.avg",
      "glyph": "\uf4e3",
      "format": "sec1",
      "nullText": "0.0s",
      "color": {
        "thresholds": [
          { "op": "gte", "n": 30000, "color": "red" },
          { "op": "gte", "n": 10000, "color": "yellow" }
        ],
        "default": "green"
      },
      "priority": 40
    },
    "tps": {
      "source": "tps",
      "format": "tps1",
      "nullText": "0.0tok/s",
      "prefix": "speed ",
      "color": "cyan",
      "priority": 95
    },
    "tpsAvg": {
      "source": "tps.avg",
      "glyph": "\udb81\udcc5",
      "format": "tps1",
      "nullText": "0.0tok/s",
      "color": "cyan",
      "priority": 30
    },
    "todayTok": {
      "source": "ext-status",
      "key": "metrics-today-tokens",
      "glyph": "\uf073",
      "format": "tok",
      "nullText": "",
      "color": "cyan",
      "priority": 80
    },
    "todayCost": {
      "source": "ext-status",
      "key": "metrics-today-cost",
      "glyph": "\uef8d",
      "format": "dollars3",
      "nullText": "",
      "color": "orange",
      "priority": 75
    }
  },
  "focus": {
    "enabled": true,
    "dimUnfocused": true,
    "unfocusedColor": "comment"
  }
}
