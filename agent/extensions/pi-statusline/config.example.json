{
  "_comment": "pi-statusline config. Precedence (later overrides earlier): global ~/.pi/agent/pi-statusline.json < extension ./config.json (this dir) < project <cwd>/.pi/pi-statusline.json (trusted). Partial configs deep-merge over the built-in default. Zero config = default 4-line footer. Sources: session.cwd|session.name, footer.branch, model.id, thinking, usage.input|output|cacheRead|cacheWrite|ch|cost, ctx.percent|tokens|window|nums|bar, ttft|ttft.avg, tps|tps.avg, task.elapsed|task.elapsedTotal, focus, ext-status (key), literal (text). color: 'name' | {map:{val->name},default} | {thresholds:[{op,n,color}],default}. Palette: fg fgDark comment dark5 blue cyan blue5 magenta purple orange yellow green green1 red, or raw 'R;G;B'. format: tok pct sec0 sec1 hms tps1 dollars3 int raw. hms renders milliseconds as elapsed time (5h32m47s / 12m05s / 9s). valueMap maps raw values to display text or icons while color.map still matches the raw value. truncate: 'start'|'end' (default 'end') — which side to ellipsis when a single-item side overflows; 'start' keeps the tail (e.g. cwd -> '…/pi-statusline'). Use /statusline reload after edits. FOCUS: {enabled, dimUnfocused, unfocusedColor} — subscribes to the standalone pi-focus extension on 'pi-focus:change'; pi-focus is the sole DEC 1004 owner. When dimUnfocused, the whole footer is recolored to unfocusedColor on blur so the focused pane stands out. The `focus` source returns 'focused'|'unfocused' for indicator modules (see focusDot). tmux users: add `set -g focus-events on` or pane switches won't report. /statusline focus shows current state and whether a pi-focus event has been seen.",
  "lines": [
    {
      "left": [
        "piState",
        "focusDot",
        "title"
      ],
      "sepLeft": " ",
      "right": [
        "model",
        "thinking",
        "stier"
      ],
      "sepRight": "  "
    },
    {
      "left": [
        "cwd"
      ],
      "sepLeft": " ",
      "right": [
        "branch"
      ],
      "sepRight": " "
    },
    {
      "left": [
        "tokIn",
        "tokOut",
        "cacheR",
        "cacheW",
        "cacheHit",
        "cost"
      ],
      "sepLeft": "  ",
      "right": [
        "ctxLabel",
        "ctxBar",
        "ctxPct",
        "ctxNums"
      ],
      "sepRight": " "
    },
    {
      "full": [
        "elapsed",
        "ttft",
        "ttftAvg",
        "tps",
        "tpsAvg"
      ],
      "sep": "  "
    }
  ],
  "modules": {
    "cwd": {
      "source": "session.cwd",
      "color": "fg",
      "truncate": "start",
      "priority": 100
    },
    "piState": {
      "source": "ext-status",
      "key": "pi-status",
      "valueMap": {
        "idle": "",
        "gen": "",
        "done": ""
      },
      "color": {
        "map": {
          "idle": "comment",
          "gen": "cyan",
          "done": "green"
        },
        "default": "fgDark"
      },
      "priority": 115
    },
    "focusDot": {
      "source": "focus",
      "glyph": "●",
      "color": {
        "map": {
          "focused": "green",
          "unfocused": "comment"
        },
        "default": "fg"
      },
      "priority": 110
    },
    "title": {
      "source": "session.name",
      "color": "comment",
      "truncate": "end",
      "priority": 30
    },
    "branch": {
      "source": "footer.branch",
      "color": "green",
      "priority": 60
    },
    "model": {
      "source": "model.id",
      "color": "blue",
      "priority": 95
    },
    "thinking": {
      "source": "thinking",
      "color": "magenta",
      "priority": 40
    },
    "stier": {
      "source": "ext-status",
      "key": "service-tier",
      "glyph": "",
      "color": {
        "map": {
          "priority": "orange",
          "flex": "blue",
          "scale": "green",
          "off": "comment"
        },
        "default": "fgDark"
      },
      "priority": 35
    },
    "tokIn": {
      "source": "usage.input",
      "glyph": "",
      "format": "tok",
      "color": "cyan",
      "priority": 100
    },
    "tokOut": {
      "source": "usage.output",
      "glyph": "",
      "format": "tok",
      "color": "green1",
      "priority": 95
    },
    "cacheR": {
      "source": "usage.cacheRead",
      "glyph": "󱉛",
      "format": "tok",
      "color": "blue5",
      "priority": 50
    },
    "cacheW": {
      "source": "usage.cacheWrite",
      "glyph": "󱉙",
      "format": "tok",
      "color": "purple",
      "priority": 40
    },
    "cacheHit": {
      "source": "usage.ch",
      "glyph": "",
      "format": "pct",
      "nullText": "0%",
      "color": "yellow",
      "priority": 45
    },
    "cost": {
      "source": "usage.cost",
      "glyph": "",
      "format": "dollars3",
      "color": "orange",
      "priority": 70
    },
    "elapsed": {
      "source": "task.elapsedTotal",
      "glyph": "",
      "format": "hms",
      "nullText": "0s",
      "color": "yellow",
      "priority": 95
    },
    "ctxLabel": {
      "source": "literal",
      "text": "ctx",
      "color": "comment",
      "priority": 100
    },
    "ctxBar": {
      "source": "ctx.bar",
      "cells": 8,
      "color": {
        "thresholds": [
          {
            "op": "gte",
            "n": 80,
            "color": "red"
          },
          {
            "op": "gte",
            "n": 50,
            "color": "yellow"
          }
        ],
        "default": "green"
      },
      "priority": 60
    },
    "ctxPct": {
      "source": "ctx.percent",
      "format": "pct",
      "nullText": "?",
      "color": {
        "thresholds": [
          {
            "op": "gte",
            "n": 80,
            "color": "red"
          },
          {
            "op": "gte",
            "n": 50,
            "color": "yellow"
          }
        ],
        "default": "green"
      },
      "priority": 95
    },
    "ctxNums": {
      "source": "ctx.nums",
      "color": "fgDark",
      "priority": 40
    },
    "ttft": {
      "source": "ttft",
      "glyph": "",
      "format": "sec1",
      "nullText": "0.0s",
      "color": {
        "thresholds": [
          {
            "op": "gte",
            "n": 3000,
            "color": "red"
          },
          {
            "op": "gte",
            "n": 1000,
            "color": "yellow"
          }
        ],
        "default": "green"
      },
      "priority": 100
    },
    "ttftAvg": {
      "source": "ttft.avg",
      "format": "sec1",
      "prefix": "(avg ",
      "suffix": ")",
      "color": "comment",
      "priority": 40
    },
    "tps": {
      "source": "tps",
      "glyph": "",
      "format": "tps1",
      "nullText": "0.0tok/s",
      "color": "cyan",
      "priority": 95
    },
    "tpsAvg": {
      "source": "tps.avg",
      "format": "tps1",
      "prefix": "(avg ",
      "suffix": ")",
      "color": "comment",
      "priority": 30
    }
  },
  "focus": {
    "enabled": true,
    "dimUnfocused": false,
    "unfocusedColor": "comment"
  }
}
